# Make the root package.json "engines" field actually enforced. Without
# this, npm only warns on a Node version mismatch and installs anyway --
# CI (.github/workflows/*.yml) pins Node 22 explicitly, and
# @supabase/supabase-js warns on Node 20, so a local install on the wrong
# version can silently diverge from what CI runs. `nvm use` (reads
# .nvmrc) picks the right version; this makes npm refuse to proceed if
# you forgot to.
engine-strict=true
