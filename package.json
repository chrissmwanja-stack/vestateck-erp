{
  "name": "erp-platform",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web"
  },
  
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild@0.25.12": true
  }
}
