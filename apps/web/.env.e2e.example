# Copy this file to .env.e2e and fill in the values `supabase status`
# prints after `supabase start`. Used ONLY by `npm run test:e2e` (via
# playwright.config.ts) to point the dev server it boots at your LOCAL
# Supabase stack — it never touches apps/web/.env, so your normal
# `npm run dev` setup (which may point at a live/linked project) is
# unaffected.
#
# Typical local defaults (confirm with `supabase status`):
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
