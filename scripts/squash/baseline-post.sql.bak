-- ============================================================================
-- baseline-post.patch.sql
--
-- Edits for scripts/squash/baseline-post.sql. Two changes:
--   PATCH A (§4a) — recreate the three po_documents_tenant_* policies on
--                   storage.objects. RC-4: they are nowhere in the baseline,
--                   because pg_dump --schema=public cannot carry storage
--                   policies and the remote_schema migrations that created
--                   them are archived and no longer replayed.
--   PATCH B (§4c) — scope material_catalog_insert to authenticated.
--                   RC-5: no TO clause = polroles {public}.
--
-- BEFORE APPLYING: recover the real predicates. The archive is still on disk.
--
--   Select-String -Path supabase\migrations_archive\2026-11\*.sql `
--                 -Pattern 'po_documents_tenant' -Context 2,14
--   Select-String -Path supabase\migrations_archive\2026-11\20260902150000_recreate_po_documents_bucket.sql `
--                 -Pattern 'policy' -Context 2,14
--   Select-String -Path supabase\migrations_archive\2026-11\20260822120000_material_catalog_insert_policy.sql `
--                 -Pattern 'create policy' -Context 0,8
--
-- The block below mirrors the tenant_documents_tenant_* shape already in
-- baseline-post.sql. If the originals differed, use the originals — and prove
-- it with the fingerprint hashes at the bottom of this file.
-- ============================================================================


-- ============================ PATCH A =====================================
-- Insert into baseline-post.sql §4a, immediately after the
-- tenant_documents_tenant_update policy.

-- po-documents RLS policies. RC-4: the pre-squash comment claimed these were
-- "in the remote_schema migrations already included in the dump body". They
-- were not: pg_dump ran with --schema=public, so no storage.objects policy is
-- in the dump, and the remote_schema migrations (20260824064800,
-- 20260824110748, 20260901135345, 20260903112116, 20260904082722,
-- 20260910113534, 20260910133254) plus 20260902150000_recreate_po_documents_bucket
-- are archived and no longer replayed. Without these three policies
-- storage.objects RLS denies everything for the po-documents bucket: PO
-- attachment uploads insert 0 rows and listings return empty.

drop policy if exists "po_documents_tenant_insert" on storage.objects;
create policy "po_documents_tenant_insert" on storage.objects
  for insert to authenticated
  with check (bucket_id = 'po-documents'
              and (storage.foldername(name))[1] = (public.get_my_tenant_id())::text);

drop policy if exists "po_documents_tenant_select" on storage.objects;
create policy "po_documents_tenant_select" on storage.objects
  for select to authenticated
  using (bucket_id = 'po-documents'
         and (storage.foldername(name))[1] = (public.get_my_tenant_id())::text);

drop policy if exists "po_documents_tenant_update" on storage.objects;
create policy "po_documents_tenant_update" on storage.objects
  for update to authenticated
  using (bucket_id = 'po-documents'
         and (storage.foldername(name))[1] = (public.get_my_tenant_id())::text)
  with check (bucket_id = 'po-documents'
              and (storage.foldername(name))[1] = (public.get_my_tenant_id())::text);

-- No delete policy, mirroring tenant-documents and the original migrations.

-- NOTE ON ORDERING: these policies call public.get_my_tenant_id(). Step 5b of
-- the squash script appends `REVOKE ALL ON ROUTINE ... FROM PUBLIC` AFTER this
-- post-block. get_my_tenant_id() must be on 5b's re-grant allowlist for
-- `authenticated`, or these policies raise `permission denied for function`
-- at query time. Same for has_po_access() below. Verify with:
--
--   select has_function_privilege('authenticated',
--          'public.get_my_tenant_id()'::regprocedure, 'EXECUTE');



-- ============================ VERIFICATION ================================
-- After the next reset, these must match the OLD side of squash-catalog-diff.txt:
--
--   pol|storage.objects.po_documents_tenant_insert|INSERT|PERMISSIVE|{authenticated}|9ab9b51ae2581963c767e357a43aeb25
--   pol|storage.objects.po_documents_tenant_select|SELECT|PERMISSIVE|{authenticated}|6e89a9409796bf513c0398b6dcb8e174
--   pol|storage.objects.po_documents_tenant_update|UPDATE|PERMISSIVE|{authenticated}|6e89a9409796bf513c0398b6dcb8e174
--
-- The fingerprint hashes them as md5(coalesce(qual,'') || '~' || coalesce(with_check,''))
-- from pg_policies, so run this to compare directly:

select policyname, cmd, permissive, roles::text,
       md5(coalesce(qual, '') || '~' || coalesce(with_check, '')) as fp_hash
from pg_policies
where schemaname = 'storage' and tablename = 'objects'
order by policyname;

-- Expected: select and update share a hash (identical USING), insert differs.
-- If your hashes do not match 9ab9b51a / 6e89a940, the original predicates
-- differed from the mirror above — go back to the archive and copy them verbatim.
-- A paraphrase that happens to work is not equivalence, and the whole point of
-- the fingerprint is to prove equivalence.

select policyname, cmd, roles::text,
       md5(coalesce(qual, '') || '~' || coalesce(with_check, '')) as fp_hash
from pg_policies
where schemaname = 'public' and tablename = 'material_catalog'
order by policyname;

drop extension if exists "pg_net";
drop policy if exists po_documents_tenant_insert on storage.objects;
create policy po_documents_tenant_insert on storage.objects as permissive for insert to authenticated with check (((bucket_id = 'po-documents'::text) AND ((storage.foldername(name))[1] = (get_my_tenant_id())::text)));
drop policy if exists po_documents_tenant_select on storage.objects;
create policy po_documents_tenant_select on storage.objects as permissive for select to authenticated using (((bucket_id = 'po-documents'::text) AND ((storage.foldername(name))[1] = (get_my_tenant_id())::text)));
drop policy if exists po_documents_tenant_update on storage.objects;
create policy po_documents_tenant_update on storage.objects as permissive for update to authenticated using (((bucket_id = 'po-documents'::text) AND ((storage.foldername(name))[1] = (get_my_tenant_id())::text)));

